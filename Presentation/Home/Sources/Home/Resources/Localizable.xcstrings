    "home.musicAccess.message" : {
      "comment" : "A description of the Apple Music access needed for the home view.",
      "extractionState" : "manual",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BeatRate uses the Apple Music catalog for album artwork, tracklists and release details. Turn it on in Settings to fill your feed."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BeatRate korzysta z katalogu Apple Music, aby wyświetlać okładki albumów, listy utworów i szczegóły wydań. Włącz dostęp w Ustawieniach, aby wypełnić ekran główny."
          }
        }
      }
    },
