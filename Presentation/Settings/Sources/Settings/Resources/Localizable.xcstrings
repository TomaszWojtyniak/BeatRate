    "settings.deleteAccount.error" : {
      "comment" : "A message displayed when the user can't delete their account.",
      "extractionState" : "manual",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We couldn't finish deleting your account. Please try again."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się dokończyć usuwania konta. Spróbuj ponownie."
          }
        }
      }
    },
    "settings.deleteAccount.footer" : {
      "comment" : "The text that appears below the \"Delete Account\" button in the Settings view.",
      "extractionState" : "manual",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permanently deletes your account and all your ratings and favorites. This can't be undone."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trwale usuwa twoje konto oraz wszystkie oceny i ulubione albumy. Tej operacji nie można cofnąć."
          }
        }
      }
    },
    "settings.deleteAccount.message" : {
      "comment" : "The body of the delete account sheet.",
      "extractionState" : "manual",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This permanently deletes your account and all your ratings and favorites. This can't be undone. Confirm with your Apple ID to continue."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spowoduje to trwałe usunięcie twojego konta oraz wszystkich ocen i ulubionych albumów. Tej operacji nie można cofnąć. Aby kontynuować, potwierdź za pomocą Apple ID."
          }
        }
      }
    },
