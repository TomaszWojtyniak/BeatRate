    "splash.error.connection" : {
      "comment" : "Error message displayed when the app fails to connect to the network after the maximum number of retries has been reached.",
      "extractionState" : "manual",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unable to connect. Please check your connection and try again later."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można nawiązać połączenia. Sprawdź połączenie z internetem i spróbuj ponownie później."
          }
        }
      }
    },
    "splash.error.noData" : {
