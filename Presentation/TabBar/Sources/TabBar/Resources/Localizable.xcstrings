    "musicAccess.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BeatRate needs music library access to show album artwork, tracklists and release details. No subscription required — turn on access in Settings to use the app."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BeatRate potrzebuje dostępu do biblioteki muzycznej, aby wyświetlać okładki albumów, listy utworów i szczegóły wydań. Subskrypcja nie jest wymagana — włącz dostęp w Ustawieniach, aby korzystać z aplikacji."
          }
        }
      }
    },
    "musicAccess.openSettings" : {
