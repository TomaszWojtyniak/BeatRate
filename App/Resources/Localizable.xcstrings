    "analyticsConsent.message" : {
      "comment" : "The text in the alert that asks the user to allow analytics.",
      "extractionState" : "manual",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Share usage analytics, like which screens you open, so we can make the app better. No ads and no tracking across other apps. You can change this anytime in Settings."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udostępniaj dane analityczne o korzystaniu z aplikacji, np. które ekrany otwierasz, abyśmy mogli ją ulepszać. Żadnych reklam ani śledzenia w innych aplikacjach. Możesz to zmienić w dowolnej chwili w Ustawieniach."
          }
        }
      }
    },
